# Backend Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control

# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=dashboard_user
DATABASE_PASSWORD=dashboard_pass
DATABASE_NAME=team_dashboard

# JWT — REQUIRED: app refuses to start without this value
JWT_SECRET=change-me-to-a-secure-random-string-min-32-chars

# CORS — comma-separated exact origins
CORS_ORIGINS=http://localhost:3000
# CORS — comma-separated regex patterns for wildcard domains (no surrounding slashes)
# Example for Cloudflare tunnels: CORS_REGEX=\.trycloudflare\.com$
CORS_REGEX=

# Frontend URL (used to generate invite links)
APP_URL=http://localhost:3000

# Email (Nodemailer) — leave empty to disable email sending (graceful degradation)
# For dev: use Mailtrap (https://mailtrap.io) to capture emails without sending
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@zenkai.app
